<beans default-lazy-init="true" xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
            http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
            http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.2.xsd">

    <context:component-scan base-package="com.jaxio.celerio"/>
    <context:property-placeholder location="classpath*:build.properties,classpath*:release.properties"/>

    <bean id="buildInfo" class="com.jaxio.celerio.configuration.BuildInfo">
        <property name="pomVersion" value="${pom.version}"/>
        <property name="pomName" value="${pom.name}"/>
        <property name="pomGroupId" value="${pom.groupId}"/>
        <property name="pomArtifactId" value="${pom.artifactId}	"/>
    </bean>

    <bean id="celerioMarshaller" class="org.springframework.oxm.jaxb.Jaxb2Marshaller">
        <property name="classesToBeBound">
            <list>
                <value>com.jaxio.celerio.configuration.Celerio</value>
            </list>
        </property>
    </bean>

    <bean id="dbMetadataMarshaller" class="org.springframework.oxm.jaxb.Jaxb2Marshaller">
        <property name="classesToBeBound">
            <list>
                <value>com.jaxio.celerio.configuration.database.Metadata</value>
            </list>
        </property>
    </bean>

    <bean id="eclipseProfilesMarshaller" class="org.springframework.oxm.jaxb.Jaxb2Marshaller">
        <property name="classesToBeBound">
            <list>
                <value>com.jaxio.celerio.configuration.eclipse.Profiles</value>
            </list>
        </property>
    </bean>

    <bean id="celerioPackMarshaller" class="org.springframework.oxm.jaxb.Jaxb2Marshaller">
        <property name="classesToBeBound">
            <list>
                <value>com.jaxio.celerio.configuration.pack.CelerioPack</value>
            </list>
        </property>
    </bean>


    <bean class="org.apache.velocity.app.VelocityEngine" init-method="init">
        <description>
            Load templates from the filesystem and fall back to the classpath.
        </description>
        <property name="velocityProperties">
            <props>
                <prop key="runtime.references.strict">true</prop>
                <prop key="runtime.log.invalid.references">true</prop>

                <prop key="resource.loader">file, class</prop>

                <prop key="file.resource.loader.description">Velocity File Resource Loader</prop>
                <prop key="file.resource.loader.class">org.apache.velocity.runtime.resource.loader.FileResourceLoader
                </prop>
                <prop key="file.resource.loader.path">., src/main/velocity</prop>
                <prop key="file.resource.loader.cache">true</prop>
                <prop key="file.resource.loader.modificationCheckInterval">-1</prop>

                <prop key="class.resource.loader.description">Velocity Classpath Resource Loader</prop>
                <prop key="class.resource.loader.class">
                    org.apache.velocity.runtime.resource.loader.ClasspathResourceLoader
                </prop>
            </props>
        </property>
    </bean>
</beans>
